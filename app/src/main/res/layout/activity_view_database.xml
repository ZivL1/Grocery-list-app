<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/view_db">

    <!-- Top Half: ListView -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="רשימת הקניות"
        android:layout_marginLeft="150dp"
        android:textSize="20dp"/>

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Half Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Horizontal row for EditText and TextView -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etSearchName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="הכנס שם"
                android:inputType="textPersonName"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/textViewNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שם"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- First Button -->
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="חיפוש לפי שם"
            android:layout_marginBottom="8dp" />

        <!-- Second Button -->
        <Button
            android:id="@+id/btnEditDB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="לעריכת רשימת הקניות" />

    </LinearLayout>

</LinearLayout>